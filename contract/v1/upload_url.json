{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /upload_url",
  "description": "Request and response for one signed single-object PUT URL. The object path is chosen by the control plane.",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["from", "to", "asset", "venue", "quote", "name"],
      "additionalProperties": false,
      "properties": {
        "from": {"$ref": "job.json#/properties/from"},
        "to": {"$ref": "job.json#/properties/to"},
        "asset": {"$ref": "job.json#/properties/asset"},
        "venue": {"$ref": "job.json#/properties/venue"},
        "quote": {"$ref": "job.json#/properties/quote"},
        "name": {"type": "string", "enum": ["orders.raw", "orders.mapped", "fills.raw", "fills.mapped"]}
      }
    },
    "response": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri", "minLength": 1}
      }
    }
  }
}
